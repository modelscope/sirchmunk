# benchmarks/.env.global.example — Layer 0 shared global config template
#
# Purpose:
#   This file is the lowest-priority config layer (Layer 0) for every benchmark.
#   Copy it to benchmarks/.env.global and fill in the real API key; all benchmarks then
#   inherit these values, so there is no need to repeat them in each benchmark profile
#   env file.
#
# Precedence (low to high):
#   .env.global  ->  benchmark base env  ->  benchmark profile env  ->  os.environ
#   For HotpotQA: .env.global < .env.hotpotqa.base < .env.hotpotqa.frozen < os.environ.
#
# When to change this file:
#   - switching LLM provider (for example from DashScope to OpenAI)
#   - updating the shared API key
#   - changing the embedding model
#
# Layer 0 change reminder:
#   Any change here is a Layer 0 GLOBAL change and affects every benchmark.
#   When running run_research_loop.py, ImprovementAdvisor annotates and warns about it.

# ===== LLM settings (shared globally) =====
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# Each benchmark may override this value with LLM_MODEL_NAME in its own .env file
LLM_MODEL_NAME=qwen3.7-plus
LLM_TIMEOUT=120

# ===== Search process controls (shared globally) =====
# Keep per-query fan-out below the global subprocess limit to prevent queue starvation.
GREP_CONCURRENT_LIMIT=5
GREP_KEYWORD_CONCURRENT_LIMIT=2
GREP_FALLBACK_CONCURRENT_LIMIT=2
GREP_TIMEOUT=60.0
GREP_QUEUE_TIMEOUT=10.0
GREP_FALLBACK_TIMEOUT=15.0
GREP_PROCESS_KILL_TIMEOUT=5.0
GREP_RGA_BACKOFF_SECONDS=60.0
GREP_FALLBACK_TO_RG=true

# ===== Adaptive discovery and reading (shared globally) =====
SIRCHMUNK_SCOPE_PLANNER_ENABLED=true
SIRCHMUNK_SCOPE_PLANNER_CONFIDENCE=0.75
SIRCHMUNK_SCOPE_PLANNER_MAX_PATHS=4
SIRCHMUNK_DIRECTORY_PROFILE_MAX_ENTRIES=100000
SIRCHMUNK_DIRECTORY_PROFILE_MAX_DEPTH=8
SIRCHMUNK_FILE_LIST_PAGE_SIZE=100
SIRCHMUNK_FILE_READ_MAX_CHARS=60000
SIRCHMUNK_FILE_READ_SMALL_FILE_CHARS=30000
SIRCHMUNK_FILE_READ_WINDOW_LINES=80

# ===== Embedding settings (optional, shared globally) =====
# When left empty, each benchmark falls back to its default.
# The LightRAG v1.3.6 SDK baseline also reads EMBEDDING_MODEL_ID; set it to an
# OpenAI-compatible embedding model supported by the current LLM_BASE_URL.
# Examples: OpenAI can use text-embedding-3-small; for DashScope, pick a model available
# to your account.
# LightRAG experiment parameters such as query mode / working_dir / max files are passed
# through the CLI and are not kept in the global env.
# EMBEDDING_MODEL_ID=
# EMBEDDING_CACHE_DIR=~/.sirchmunk/models
